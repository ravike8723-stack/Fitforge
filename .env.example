# ============================================================================
# FITFORGE PERSONAL TRAINING & ONLINE COACHING — ENVIRONMENT CONFIGURATION
# ============================================================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5000

# Database (Optional for Demo Mode)
MONGODB_URI=mongodb://127.0.0.1:27017/fitforge_coaching

# Authentication
JWT_SECRET=fitforge_demo_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Optional Email & Calendar Providers
EMAIL_ENABLED=false
CALENDAR_ENABLED=false
BOOKING_PROVIDER=mock
